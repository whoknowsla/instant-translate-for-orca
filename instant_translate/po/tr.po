msgid "Instant Translate"
msgstr "Anında Çeviri"

#: instant_translate/__init__.py:54
msgid ""
"Translates selected or clipboard text using Google Translate, Yandex "
"Translate, or DeepL."
msgstr ""
"Seçili metni veya pano metnini Google Translate, Yandex Translate ya da "
"DeepL kullanarak çevirir."

#: instant_translate/backends/base.py:46
